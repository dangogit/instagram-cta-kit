[Unit]
Description=Instagram CTA Kit
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/instagram-cta-kit
ExecStart=REPLACE_WITH_NODE_PATH /opt/instagram-cta-kit/bin/instagram-cta.mjs start --dir /opt/instagram-cta-kit
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
