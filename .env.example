# Server
PORT=18787
HOST=127.0.0.1
DEFAULT_LOCALE=en
DRY_RUN=1

# Meta app and Instagram Professional account
VERIFY_TOKEN=replace-with-a-random-webhook-verify-token
META_APP_SECRET=replace-with-meta-app-secret
IG_USER_ID=replace-with-instagram-professional-account-id
IG_ACCESS_TOKEN=replace-with-long-lived-instagram-user-token
GRAPH_BASE_URL=https://graph.instagram.com/v25.0

# Routes and local state
ROUTES_FILE=./routes.json
STATE_FILE=./state/events.jsonl
WEBHOOK_LOG_FILE=./state/webhooks.jsonl
LOG_WEBHOOK_CONTENT=0
CTA_ATTRIBUTION_SECRET=replace-with-a-long-random-secret

# Polling fallback. Webhooks are preferred for production.
POLL_ENABLED=1
POLL_INTERVAL_MS=60000
POLL_MEDIA_LIMIT=100
POLL_COMMENTS_LIMIT=100
POLL_CONVERSATION_LIMIT=25
POLL_MESSAGES_LIMIT=10
POLL_MAX_COMMENT_PAGES=20
POLL_MAX_CONVERSATION_PAGES=20
POLL_MAX_MESSAGE_PAGES=20
POLL_CURSOR_FILE=./state/poll-cursor.json
POLL_MESSAGE_CURSOR_FILE=./state/message-poll-cursor.json

# Keep disabled. Follow checks should run after a fresh user action.
FOLLOW_GATE_GUIDE_ENABLED=0

# Optional sanitized product analytics. Disabled when unset.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=
