# Server
PORT=18787
HOST=127.0.0.1
ALLOW_INSECURE_HTTP=0
DEFAULT_LOCALE=en
DRY_RUN=1

# Recommended provider: HookMyApp
CTA_PROVIDER=hookmyapp
VERIFY_TOKEN=replace-with-webhook-verify-token
INSTAGRAM_GRAPH_API_URL=replace-with-hookmyapp-instagram-graph-api-url
INSTAGRAM_ACCESS_TOKEN=replace-with-hookmyapp-channel-token
INSTAGRAM_ACCOUNT_ID=replace-with-instagram-professional-account-id
HOOKMYAPP_CHANNEL_ID=replace-with-hookmyapp-channel-id
WEBHOOK_HMAC_SECRET=replace-with-hookmyapp-webhook-hmac-secret

# Direct Meta alternative. Replace the HookMyApp block with these values.
# CTA_PROVIDER=meta
# VERIFY_TOKEN=replace-with-webhook-verify-token
# META_APP_SECRET=replace-with-meta-app-secret
# IG_USER_ID=replace-with-instagram-professional-account-id
# IG_ACCESS_TOKEN=replace-with-long-lived-instagram-user-token
# GRAPH_BASE_URL=https://graph.instagram.com/v25.0

# Routes, event history, and durable recovery
ROUTES_FILE=./routes.json
STATE_FILE=./state/events.jsonl
WEBHOOK_LOG_FILE=./state/webhooks.jsonl
CTA_QUEUE_DIR=./state/inbox
RECOVERY_STATUS_FILE=./state/recovery-status.json
RECONCILIATION_STATUS_FILE=./state/reconciliation-status.json
CTA_ADMIN_TOKEN=replace-with-a-long-random-admin-token
CTA_ATTRIBUTION_SECRET=replace-with-a-long-random-attribution-secret
RECOVERY_INTERVAL_MS=1000
RECOVERY_RETRY_BASE_MS=30000
RECOVERY_MAX_ATTEMPTS=5

LOG_WEBHOOK_CONTENT=0
MAX_WEBHOOK_BODY_BYTES=1048576
META_REQUEST_TIMEOUT_MS=10000

# Continuous polling is optional. Webhooks are preferred.
POLL_ENABLED=0
POLL_INTERVAL_MS=60000
POLL_MEDIA_LIMIT=100
POLL_COMMENTS_LIMIT=100
POLL_CONVERSATION_LIMIT=25
POLL_MESSAGES_LIMIT=10
POLL_MAX_COMMENT_PAGES=20
POLL_MAX_CONVERSATION_PAGES=20
POLL_MAX_MESSAGE_PAGES=20
POLL_CURSOR_FILE=./state/poll-cursor.json
POLL_MESSAGE_CURSOR_FILE=./state/message-poll-cursor.json

# Six-hour scan for events missed by webhook delivery.
RECONCILE_ENABLED=1
RECONCILE_INTERVAL_MS=21600000
RECONCILE_RETRY_MS=300000

# Keep disabled. Follow checks should run after fresh user action.
FOLLOW_GATE_GUIDE_ENABLED=0

# Optional sanitized product analytics
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=
